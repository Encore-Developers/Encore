{
	"$schema": "./schema/pipelines.json",
	"pipelines": {
		"box": {
			"preset": "2d",
			"vertexShader": "boxVert",
			"fragmentShader": "boxFrag",
			"primitiveType": "triangleStrip"
		},
		"compositeLayer": {
			"preset": "compositor",
			"vertexShader": "compositeLayerVert",
			"fragmentShader": "compositeLayerFrag",
			"primitiveType": "triangleStrip"
		}
	}
}